rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidCategory(cat) {
      return cat in ['libros', 'cine', 'teatro', 'musica', 'espacios'];
    }

    function isValidEra(era) {
      return era in ['clasicos', 'contemporaneo', 'imperdibles'];
    }

    function isValidPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'province', 'favoriteDiscipline', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'province', 'favoriteDiscipline', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.province is string && data.province.size() >= 1 && data.province.size() <= 60
        && isValidCategory(data.favoriteDiscipline)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidSavedItem(data, userId, itemId) {
      return data.keys().hasAll(['userId', 'itemId', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'itemId', 'note', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.itemId is string && data.itemId == itemId && data.itemId.size() <= 80 && isValidId(data.itemId)
        && data.note is string && data.note.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRecommendation(data, recId) {
      return data.keys().hasAll([
          'id', 'accessionCode', 'title', 'creator', 'year', 'category', 'era',
          'genre', 'location', 'province', 'summary', 'editorialEssay',
          'whereToExperience', 'authorUid', 'authorName', 'isPublic', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'accessionCode', 'title', 'creator', 'year', 'category', 'era',
          'genre', 'location', 'province', 'summary', 'editorialEssay',
          'whereToExperience', 'authorUid', 'authorName', 'isPublic', 'createdAt'
        ])
        && data.id is string && data.id == recId && data.id.size() <= 80 && isValidId(data.id)
        && data.accessionCode is string && data.accessionCode.size() >= 3 && data.accessionCode.size() <= 24
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.creator is string && data.creator.size() >= 2 && data.creator.size() <= 100
        && data.year is int && data.year >= 1810 && data.year <= 2030
        && isValidCategory(data.category)
        && isValidEra(data.era)
        && data.genre is string && data.genre.size() >= 1 && data.genre.size() <= 80
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 80
        && data.province is string && data.province.size() >= 1 && data.province.size() <= 60
        && data.summary is string && data.summary.size() >= 5 && data.summary.size() <= 400
        && data.editorialEssay is string && data.editorialEssay.size() >= 5 && data.editorialEssay.size() <= 1500
        && data.whereToExperience is string && data.whereToExperience.size() >= 2 && data.whereToExperience.size() <= 250
        && data.authorUid is string && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.isPublic is bool && data.isPublic == true
        && data.createdAt is timestamp;
    }

    // Public profile (no PII)
    match /users/{userId}/public/{docId} {
      allow get: if isValidId(userId) && docId == 'profile' && isOwner(userId);
      allow create: if isValidId(userId)
        && docId == 'profile'
        && isOwner(userId)
        && isValidPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && docId == 'profile'
        && isOwner(userId)
        && isValidPublicProfile(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'province', 'favoriteDiscipline', 'updatedAt'])
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && docId == 'profile' && isOwner(userId);
    }

    // Private PII isolated to owner
    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && docId == 'info' && isOwner(userId);
      allow create: if isValidId(userId)
        && docId == 'info'
        && isOwner(userId)
        && isValidPrivateInfo(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isValidId(userId)
        && docId == 'info'
        && isOwner(userId)
        && isValidPrivateInfo(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['email'])
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(userId) && docId == 'info' && isOwner(userId);
    }

    // Saved personal cultural list & notes
    match /users/{userId}/savedItems/{itemId} {
      allow get: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
      allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
      allow create: if isValidId(userId)
        && isValidId(itemId)
        && isOwner(userId)
        && isValidSavedItem(incoming(), userId, itemId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidId(itemId)
        && isOwner(userId)
        && isValidSavedItem(incoming(), userId, itemId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['note', 'updatedAt'])
        && incoming().userId == existing().userId
        && incoming().itemId == existing().itemId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
    }

    // Public community cultural recommendations
    match /recommendations/{recId} {
      allow get: if isValidId(recId) && existing().isPublic == true;
      allow list: if resource.data.isPublic == true;
      allow create: if isValidId(recId)
        && isVerifiedUser()
        && isValidRecommendation(incoming(), recId)
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(recId)
        && isVerifiedUser()
        && existing().authorUid == request.auth.uid
        && isValidRecommendation(incoming(), recId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'creator', 'year', 'category', 'era', 'genre',
          'location', 'province', 'summary', 'editorialEssay', 'whereToExperience'
        ])
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(recId) && isVerifiedUser() && existing().authorUid == request.auth.uid;
    }
  }
}
